					"title": "線香花火",
					"language": "html",
					"code": "<!doctype html>\n<html>\n<body style=\"margin:0;background:#120d0a;overflow:hidden\">\n<canvas id=\"c\"></canvas>\n<script>\n  // 線香花火：火の玉から火花が飛び、途中で枝分かれしながら消えていく\n  const c = document.getElementById(\"c\");\n  const g = c.getContext(\"2d\");\n  const sparks = [];\n  const MAX = 900; // 火花の上限（重くならないように）\n\n  function resize() {\n    c.width = innerWidth * devicePixelRatio;\n    c.height = innerHeight * devicePixelRatio;\n  }\n  addEventListener(\"resize\", resize);\n  resize();\n\n  function spark(x, y, angle, speed, life, depth) {\n    if (sparks.length < MAX) sparks.push({ x, y, px: x, py: y, angle, speed, life, depth });\n  }\n\n  function frame() {\n    const s = devicePixelRatio;\n    const cx = c.width / 2;\n    const cy = c.height * 0.45;\n\n    // 少しずつ暗くして、火花の軌跡を残す\n    g.globalCompositeOperation = \"source-over\";\n    g.fillStyle = \"rgba(18, 13, 10, 0.2)\";\n    g.fillRect(0, 0, c.width, c.height);\n\n    // 火の玉から、ときどき新しい火花\n    for (let i = 0; i < 3; i++) {\n      if (Math.random() < 0.6) {\n        spark(cx, cy, Math.random() * Math.PI * 2, (5 + Math.random() * 6) * s, 1, 0);\n      }\n    }\n\n    g.globalCompositeOperation = \"lighter\";\n    g.lineCap = \"round\";\n    for (let i = sparks.length - 1; i >= 0; i--) {\n      const p = sparks[i];\n      p.px = p.x;\n      p.py = p.y;\n      p.x += Math.cos(p.angle) * p.speed;\n      p.y += Math.sin(p.angle) * p.speed + 0.15 * s; // 少しだけ落ちる\n      p.speed *= 0.955;\n      p.angle += (Math.random() - 0.5) * 0.25;\n      p.life -= 0.016 + p.depth * 0.012;\n\n      // 途中で 2〜3 本に枝分かれする（松葉のような形になる）\n      if (p.depth < 3 && p.life < 0.85 && Math.random() < 0.12) {\n        const n = 3 + (Math.random() < 0.5 ? 2 : 0);\n        for (let k = 0; k < n; k++) {\n          spark(p.x, p.y, p.angle + (Math.random() - 0.5) * 2.2, p.speed * 1.4 + 1.5 * s, p.life, p.depth + 1);\n        }\n        p.life = 0;\n      }\n\n      if (p.life <= 0) {\n        sparks.splice(i, 1);\n        continue;\n      }\n      g.strokeStyle = `rgba(255, ${190 + p.depth * 15}, ${110 + p.depth * 30}, ${p.life})`;\n      g.lineWidth = (2 - p.depth * 0.4) * s;\n      g.beginPath();\n      g.moveTo(p.px, p.py);\n      g.lineTo(p.x, p.y);\n      g.stroke();\n    }\n\n    // 火の玉\n    const r = 6 * s;\n    const glow = g.createRadialGradient(cx, cy, 0, cx, cy, r * 4);\n    glow.addColorStop(0, \"rgba(255, 250, 235, 1)\");\n    glow.addColorStop(0.25, \"rgba(255, 200, 120, 0.8)\");\n    glow.addColorStop(1, \"rgba(255, 120, 40, 0)\");\n    g.fillStyle = glow;\n    g.beginPath();\n    g.arc(cx, cy, r * 4, 0, Math.PI * 2);\n    g.fill();\n\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n</script>\n</body>\n</html>\n",
					"runnable": true,
					"summary": "火の玉から飛んだ火花が、途中で 3〜5 本に枝分かれしながら消えていく。松葉のような形になる。",
