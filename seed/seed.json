					"title": "文字でドット絵",
					"language": "python",
					"code": "# 文字で描いたドット絵を、PNG 画像にする\nfrom PIL import Image\n\nART = \"\"\"\n..####..\n.#....#.\n#.#..#.#\n#......#\n#.#..#.#\n#..##..#\n.#....#.\n..####..\n\"\"\"\n\nCOLORS = {\"#\": (29, 26, 22), \".\": (255, 210, 63)}\nSCALE = 16\n\nrows = ART.strip().splitlines()\nimg = Image.new(\"RGB\", (len(rows[0]) * SCALE, len(rows) * SCALE))\nfor y, row in enumerate(rows):\n    for x, ch in enumerate(row):\n        for dy in range(SCALE):\n            for dx in range(SCALE):\n                img.putpixel((x * SCALE + dx, y * SCALE + dy), COLORS[ch])\n\nimg.save(\"smile.png\")\n",
