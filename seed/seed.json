				"id": "wavy-lines",
				"slug": "wavy-lines",
				"status": "published",
				"data": {
					"title": "ゆれる線",
					"language": "html",
					"code": "<!doctype html>\n<html>\n<body style=\"margin:0;background:#fffdf7\">\n<canvas id=\"c\"></canvas>\n<script>\n  // ゆれる線：少しずつずらした波を重ねて描く\n  const c = document.getElementById(\"c\");\n  const g = c.getContext(\"2d\");\n  const colors = [\"#ff6fae\", \"#3ec6e0\", \"#ffd23f\", \"#7bd389\", \"#1d1a16\"];\n\n  function resize() {\n    c.width = innerWidth;\n    c.height = innerHeight;\n  }\n  addEventListener(\"resize\", resize);\n  resize();\n\n  function draw(time) {\n    g.clearRect(0, 0, c.width, c.height);\n    g.lineWidth = 3;\n    for (let i = 0; i < 12; i++) {\n      g.strokeStyle = colors[i % colors.length];\n      g.beginPath();\n      for (let x = 0; x <= c.width; x += 8) {\n        const y =\n          c.height / 2 +\n          Math.sin(x * 0.012 + time * 0.001 + i * 0.5) * (20 + i * 6) +\n          (i - 6) * 10;\n        x === 0 ? g.moveTo(x, y) : g.lineTo(x, y);\n      }\n      g.stroke();\n    }\n    requestAnimationFrame(draw);\n  }\n  requestAnimationFrame(draw);\n</script>\n</body>\n</html>\n",
					"runnable": true,
					"summary": "波を 12 本、少しずつずらして重ねると、布みたいに見えてくる。",
					"note": "ずっと見てられる",
					"sticker": "🌀",
					"content": [
