				"data": {
					"title": "CSS だけの目玉焼き",
					"language": "html",
					"code": "<!doctype html>\n<html>\n<head>\n<style>\n  /* CSS だけの目玉焼き。white と yolk の 2 つの要素だけ */\n  body {\n    margin: 0;\n    height: 100vh;\n    display: grid;\n    place-items: center;\n    background: #3ec6e0;\n  }\n  .white {\n    width: 180px;\n    height: 150px;\n    background: #fff;\n    border-radius: 58% 42% 55% 45% / 50% 60% 40% 50%;\n    display: grid;\n    place-items: center;\n    box-shadow: 6px 8px 0 rgb(0 0 0 / 0.15);\n    animation: wobble 3s ease-in-out infinite;\n  }\n  .yolk {\n    width: 64px;\n    height: 64px;\n    border-radius: 50%;\n    background: radial-gradient(circle at 35% 35%, #ffe680, #ffb000 60%);\n  }\n  @keyframes wobble {\n    50% { border-radius: 45% 55% 40% 60% / 60% 45% 55% 40%; }\n  }\n</style>\n</head>\n<body>\n  <div class=\"white\"><div class=\"yolk\"></div></div>\n</body>\n</html>\n",
