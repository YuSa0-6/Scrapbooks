{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Scrapbook Portfolio",
		"description": "スクラップブック風のポートフォリオ",
		"author": "YuSa0-6"
	},
	"settings": {
		"title": "Scrapbook",
		"tagline": "つくったものの切り抜き帳"
	},
	"collections": [
		{
			"slug": "projects",
			"label": "Projects",
			"labelSingular": "Project",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"urlPattern": "/work/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image",
					"required": true
				},
				{
					"slug": "client",
					"label": "Client",
					"type": "string"
				},
				{
					"slug": "year",
					"label": "Year",
					"type": "string"
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "note",
					"label": "手書きメモ（写真の下にひとこと）",
					"type": "string"
				},
				{
					"slug": "sticker",
					"label": "ステッカー（絵文字 1 つ）",
					"type": "string"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "gallery",
					"label": "Gallery",
					"type": "repeater",
					"validation": {
						"maxItems": 24,
						"subFields": [
							{
								"slug": "image",
								"label": "Image",
								"type": "image",
								"required": true
							},
							{
								"slug": "caption",
								"label": "Caption",
								"type": "text"
							}
						]
					}
				},
				{
					"slug": "url",
					"label": "Project URL",
					"type": "url"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"urlPattern": "/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": [
				"projects"
			],
			"terms": [
