{
  "name": "scrapbooks",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "predev": "pnpm --dir plugins/board-layout build",
    "dev": "astro dev",
    "prebuild": "pnpm --dir plugins/board-layout build",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "pretypecheck": "pnpm --dir plugins/board-layout build",
    "typecheck": "astro check",
    "check:docs": "node scripts/check-okf.mjs",
    "perf": "node scripts/perf.mjs",
    "load:favorites": "node scripts/load-favorites.mjs",
    "verify": "pnpm typecheck && node scripts/check-okf.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.0.1",
    "astro": "^7.3.2",
    "board-layout": "workspace:*",
    "effect": "3.22.2",
    "emdash": "^1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260820.1",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "imports": {
    "#plugins/sticker": "./src/plugins/sticker/index.ts",
    "#plugins/sticker/astro": "./src/plugins/sticker/astro/index.ts"
  }
}
