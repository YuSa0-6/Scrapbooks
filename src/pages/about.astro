---
import { getSeoMeta } from "emdash";
import { loadEntry, runPage } from "../lib/content";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const loaded = await runPage(loadEntry("pages", "about"), "Could not load the page");
if (loaded instanceof Response) return loaded;
const { entry: page, cacheHint } = loaded;
if (!page) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {
	siteUrl: Astro.url.origin,
	path: "/about",
	defaultDescription: "つくっている人のこと。",
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug: "about" }}
>
	<div class="about-page">
		<header class="about-header">
			<h1 class="about-title" {...page.edit.title}>
				<span class="marker">{page.data.title}</span>
			</h1>
		</header>

		<div class="about-content paper paper--ruled tape prose" {...page.edit.content}>
			{
				page.data.content ? (
					<PortableText value={page.data.content} />
				) : (
					<p>準備中です。</p>
				)
			}
		</div>

		<aside class="about-sidebar" aria-label="ひとことメモ">
			<section class="memo memo--yellow">
				<h2>すきなこと</h2>
				<ul>
					<li>ものづくり全般</li>
					<li>Web とアプリ</li>
					<li>ちいさな道具</li>
				</ul>
			</section>

			<section class="memo memo--pink">
				<h2>れんらく</h2>
				<p>
					<a href="/contact">お便りはこちら →</a>
				</p>
			</section>
		</aside>
	</div>
</Base>

<style>
	.about-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: var(--spacing-2xl) var(--spacing-3xl);
	}

	.about-header {
		grid-column: 1 / -1;
	}

	.about-title {
		font-size: clamp(2.25rem, 6vw, 4rem);
	}

	.about-title .marker {
		--marker: var(--hl-blue);
	}

	.about-content {
		rotate: calc(-0.5deg * var(--wobble));
	}

	.about-sidebar {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
		align-self: start;
		position: sticky;
		top: 96px;
	}

	/* ふせんメモ */
	.memo {
		padding: var(--spacing-lg);
		color: var(--c-ink);
		box-shadow: var(--shadow-paper);
	}

	.memo h2 {
		font-size: var(--font-size-lg);
		margin-bottom: var(--spacing-sm);
	}

	.memo ul {
		list-style: "✎ ";
		padding-inline-start: 1.2em;
		font-family: var(--font-hand);
		font-size: var(--font-size-lg);
	}

	.memo p {
		font-family: var(--font-hand);
		font-size: var(--font-size-lg);
	}

	.memo a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}

	.memo--yellow {
		background: #fff3a3;
		rotate: calc(2deg * var(--wobble));
	}

	.memo--pink {
		background: #ffc7df;
		rotate: calc(-3deg * var(--wobble));
	}

	@media (max-width: 768px) {
		.about-page {
			grid-template-columns: 1fr;
		}

		.about-sidebar {
			position: static;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		}
	}
</style>
