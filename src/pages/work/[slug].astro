---
import { decodeSlug, getSeoMeta } from "emdash";
import { Effect } from "effect";
import { loadCollection, loadEntry, runPage } from "../../lib/content";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ArtCard from "../../components/ArtCard.astro";
import { mountFor, transitionName } from "../../lib/pieces";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

// 1 件と「ほかの絵」は並行に読む。ほかの絵は、日付順に少し多め（3 件）に取って
// 今のものを除く（全部読んでから 2 件に切るより軽い）
const loaded = await runPage(
	Effect.all(
		{
			result: loadEntry("projects", slug),
			relatedResult: loadCollection("projects", {
				orderBy: { published_at: "desc" },
				limit: 3,
			}),
		},
		{ concurrency: "unbounded" },
	),
	"Could not load the project",
);
if (loaded instanceof Response) return loaded;
const { result, relatedResult } = loaded;
const { entry: project, cacheHint: projectCacheHint } = result;
if (!project) {
	return Astro.redirect("/404");
}

const { entries: relatedProjects, cacheHint: relatedCacheHint } = relatedResult;
const otherProjects = relatedProjects
	.filter((p) => p.id !== project.id)
	.slice(0, 2);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectCacheHint);
	Astro.cache.set(relatedCacheHint);
}

const gallery = project.data.gallery;
// 主役の写真の留め方（カードと同じ：id で決まる）と、ギャラリーのテープの色
const mount = mountFor(project.data.id);
const galleryTapes = ["var(--crayon-pink)", "var(--crayon-blue)", "var(--crayon-yellow)", "var(--crayon-sage)"];

function safeExternalUrl(value: string | undefined): string | undefined {
	if (!value) return undefined;
	try {
		const url = new URL(value);
		return url.protocol === "https:" || url.protocol === "http:"
			? url.href
			: undefined;
	} catch {
		return undefined;
	}
}

const projectUrl = safeExternalUrl(project.data.url);
const seo = getSeoMeta(project, {
	siteUrl: Astro.url.origin,
	path: `/work/${slug}`,
	defaultDescription: project.data.summary,
	defaultOgImage: project.data.featured_image?.src,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "projects", id: project.data.id, slug }}
>
	<article class="project">
		<a href="/work" class="back-link hand">← 絵の一覧にもどる</a>

		<header class="project-header">
			{
				(project.data.client || project.data.year) && (
					<p class="project-meta label-tape">
						{project.data.client && (
							<span {...project.edit.client}>{project.data.client}</span>
						)}
						{project.data.client && project.data.year && (
							<span aria-hidden="true"> / </span>
						)}
						{project.data.year && (
							<span {...project.edit.year}>{project.data.year}</span>
						)}
					</p>
				)
			}
			<h1 class="project-title" {...project.edit.title}>
				<span class="marker">{project.data.title}</span>
			</h1>
			{
				project.data.summary && (
					<p class="project-summary" {...project.edit.summary}>
						{project.data.summary}
					</p>
				)
			}
			{
				projectUrl && (
					<a
						href={projectUrl}
						class="btn-label"
						target="_blank"
						rel="noopener noreferrer"
						{...project.edit.url}
					>
						実物を見る ↗
					</a>
				)
			}
		</header>

		{
			project.data.featured_image && (
				<figure
					class:list={["featured-image", { tape: mount === "tape" }]}
					style={`view-transition-name: ${transitionName("art", project.data.id)}`}
					{...project.edit.featured_image}
				>
					<div class:list={["featured-photo", { "photo-corners": mount === "corners" }]}>
						<Image image={project.data.featured_image} />
					</div>
					{project.data.sticker && (
						<span class="sticker featured-sticker" aria-hidden="true">
							{project.data.sticker}
						</span>
					)}
					{project.data.note && (
						<figcaption class="hand" {...project.edit.note}>
							{project.data.note}
						</figcaption>
					)}
				</figure>
			)
		}

		{
			project.data.back_image && (
				<figure class="back-figure tape" {...project.edit.back_image}>
					<Image image={project.data.back_image} />
					<figcaption class="hand">うらがわ</figcaption>
				</figure>
			)
		}

		{
			project.data.content && project.data.content.length > 0 && (
				<div class="project-content paper paper--ruled prose" {...project.edit.content}>
					<PortableText value={project.data.content} />
				</div>
			)
		}

		{
			gallery && gallery.length > 0 && (
				<section class="project-gallery" aria-label="ギャラリー" {...project.edit.gallery}>
					{gallery.map((item, i) => (
						<figure
							class="gallery-item tape"
							style={`--g: ${[-2.5, 2, -1, 3][i % 4]}deg; --tape-color: ${galleryTapes[i % 4]}`}
						>
							<Image image={item.image} />
							{item.caption && <figcaption class="hand">{item.caption}</figcaption>}
						</figure>
					))}
				</section>
			)
		}
	</article>

	{
		otherProjects.length > 0 && (
			<section class="more-projects" aria-labelledby="more-title">
				<h2 id="more-title" class="label-tape">
					ほかの絵
				</h2>
				<div class="more-grid">
					{otherProjects.map((p) => (
						<ArtCard
							dbId={p.data.id}
							title={p.data.title}
							summary={p.data.summary}
							featuredImage={p.data.featured_image}
							backImage={p.data.back_image}
							href={`/work/${p.id}`}
							client={p.data.client}
							year={p.data.year}
							sticker={p.data.sticker}
							frame={p.data.frame}
							tilt={p.data.tilt}
							edit={p.edit}
							headingLevel="h3"
						/>
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	.project {
		max-width: 820px;
		margin: 0 auto;
		padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: var(--font-size-lg);
		color: var(--color-text);
		text-decoration: underline wavy var(--color-accent) 1.5px;
		text-underline-offset: 6px;
	}

	.project-header {
		margin: var(--spacing-lg) 0 var(--spacing-2xl);
	}

	.project-meta {
		margin-bottom: var(--spacing-lg);
	}

	.project-title {
		font-size: clamp(2rem, 6vw, 3.5rem);
		line-height: 1.25;
		margin-bottom: var(--spacing-lg);
	}

	.project-title .marker {
		--marker: var(--hl-pink);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	.project-summary {
		font-size: var(--font-size-lg);
		font-weight: 700;
		margin-bottom: var(--spacing-lg);
	}

	/* 主役の写真：白いふちの写真。テープか写真コーナーで留める（カードと同じ留め方） */
	.featured-image {
		position: relative;
		margin: var(--spacing-2xl) 0 var(--spacing-3xl);
		padding: 14px 14px 0;
		background: var(--color-surface);
		box-shadow: var(--shadow-paper);
		rotate: calc(-1.2deg * var(--wobble));
	}

	.featured-photo :global(img) {
		width: 100%;
	}

	/* 写真コーナーは写真のすみに。ふちの内側に収める */
	.featured-photo.photo-corners::after {
		inset: -4px;
	}

	/* 手書きのメモは赤ペン */
	.featured-image figcaption {
		padding: var(--spacing-sm) var(--spacing-xs) var(--spacing-md);
		font-size: var(--font-size-lg);
		color: var(--color-accent);
	}

	.featured-image:not(:has(figcaption)) {
		padding-bottom: 14px;
	}

	.featured-sticker {
		position: absolute;
		right: -18px;
		bottom: -18px;
		width: 4.5rem;
		height: 4.5rem;
		font-size: 2rem;
	}

	/* 裏の絵：主役の写真より小さく、反対向きに傾けて貼る */
	.back-figure {
		--tape-color: var(--crayon-lilac);
		width: min(100%, 420px);
		margin: calc(-1 * var(--spacing-xl)) 0 var(--spacing-3xl) auto;
		padding: 12px 12px 0;
		background: var(--color-surface);
		box-shadow: var(--shadow-paper);
		rotate: calc(1.8deg * var(--wobble));
	}

	.back-figure figcaption {
		padding: var(--spacing-xs) var(--spacing-xs) var(--spacing-sm);
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.project-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-2xl);
		margin-top: var(--spacing-3xl);
	}

	.gallery-item {
		padding: 10px;
		background: var(--color-surface);
		box-shadow: var(--shadow-paper);
		rotate: calc(var(--g) * var(--wobble));
		transition: rotate var(--spring);
	}

	.gallery-item:hover {
		rotate: 0deg;
	}

	.gallery-item figcaption {
		padding-top: var(--spacing-sm);
		color: var(--color-muted);
	}

	.more-projects {
		max-width: var(--wide-width);
		margin: var(--spacing-2xl) auto 0;
		padding: 0 var(--spacing-lg);
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-2xl);
		margin-top: var(--spacing-2xl);
	}

	@media (max-width: 640px) {
		.project-gallery,
		.more-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.featured-sticker {
			right: -6px;
			width: 3.5rem;
			height: 3.5rem;
			font-size: 1.5rem;
		}
	}
</style>
