---
/**
 * 本文に貼るステッカー。
 * - 丸・クッキー・おひさま・お花：M3E の形を淡いクレヨン色で塗り、細い手描きの線でふちどる。ホバーで別の形にモーフする
 *   （線・色・影は、同じ形の層を重ねて作る。filter: drop-shadow は使わない）
 * - 吹き出し：手描きの枠。ラベル：マスキングテープ（淡い縞）
 * 「飾り」にしたものは読み上げない（aria-hidden）。
 */
import { stickerColors, stickerShapes, type StickerShape } from "../options";

interface Props {
	node: {
		_key?: string;
		id?: string;
		text?: string;
		shape?: string;
		color?: string;
		decorative?: boolean;
	};
}

const { node } = Astro.props;
const text = (node.id ?? node.text ?? "").trim();
const shape: StickerShape = stickerShapes.some((s) => s.value === node.shape)
	? (node.shape as StickerShape)
	: "cookie";
const color = stickerColors.find((c) => c.value === node.color)?.css ?? "var(--crayon-yellow)";
const decorative = node.decorative !== false;

// 形ごとに、ホバーしたときの行き先の形を決める
const morphTo: Record<string, string> = {
	cookie: "sunny",
	sunny: "flower",
	flower: "cookie",
	circle: "cookie",
};
const isShaped = shape in morphTo;
// key から傾きを決める（表示のたびに変わらないように）
const seed = Array.from(node._key ?? text).reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
const tilt = (seed % 13) - 6;
---

{
	text && (
		<div
			class:list={["sticker-block", `sticker-block--${isShaped ? "shape" : shape}`]}
			style={`--st-color: ${color}; --st-tilt: ${tilt}deg; --shape-from: var(--shape-${shape}); --shape-to: var(--shape-${morphTo[shape] ?? "sunny"})`}
			aria-hidden={decorative ? "true" : undefined}
		>
			{
				isShaped ? (
					<span class="morph-host st-shape-host">
						<span class="morph st-shape-shadow" />
						<span class="morph st-shape-line" />
						<span class="morph st-shape" />
						<span class="st-shape-text">{text}</span>
					</span>
				) : (
					<p class="st-text">{text}</p>
				)
			}
		</div>
	)
}

<style>
	.sticker-block {
		margin: 1.5em 0;
		display: flex;
	}

	/* M3E の形のステッカー：影 → 手描きの線 → 淡いクレヨン色 の順に、同じ形の層を重ねる */
	.st-shape-host {
		position: relative;
		display: grid;
		place-items: center;
		width: 7.5rem;
		aspect-ratio: 1;
		rotate: calc(var(--st-tilt) * var(--wobble));
	}

	.st-shape-host > .morph {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.st-shape-shadow {
		background: var(--shadow-tear);
		translate: 2px 4px;
	}

	.st-shape-host > .st-shape-line {
		inset: -3px;
		background: var(--color-text);
	}

	.st-shape {
		background: var(--st-color);
	}

	.st-shape-text {
		position: relative;
		max-width: 80%;
		font-family: var(--font-heading);
		font-size: 1rem;
		line-height: 1.25;
		text-align: center;
		color: var(--crayon-ink);
	}

	/* 吹き出し：手描きの枠。しっぽも同じ線で描く */
	.sticker-block--bubble .st-text {
		position: relative;
		max-width: 28rem;
		padding: 0.8rem 1.3rem;
		font-family: var(--font-hand);
		font-weight: 600;
		font-size: var(--font-size-lg);
		line-height: 1.6;
		color: var(--color-text);
		background: var(--color-surface);
		border: 2px solid var(--color-text);
		border-radius: var(--hand-radius-soft);
		box-shadow: 4px 4px 0 var(--st-color);
		rotate: calc(var(--st-tilt) * 0.4 * var(--wobble));
		transition: rotate var(--spring), transform var(--spring);
	}

	.sticker-block--bubble .st-text::after {
		content: "";
		position: absolute;
		left: 2rem;
		bottom: -13px;
		width: 22px;
		height: 22px;
		background: var(--color-surface);
		border-right: 2px solid var(--color-text);
		border-bottom: 2px solid var(--color-text);
		border-bottom-right-radius: 6px;
		rotate: 45deg;
	}

	.sticker-block--bubble .st-text:hover {
		rotate: 0deg;
	}

	/* ラベル：マスキングテープ。淡い縞に、切れた端のぎざぎざ */
	.sticker-block--label .st-text {
		padding: 0.35rem 1.5rem;
		font-family: var(--font-hand);
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--crayon-ink);
		background: repeating-linear-gradient(
			45deg,
			var(--st-color) 0 6px,
			color-mix(in srgb, var(--st-color) 78%, var(--color-canvas)) 6px 12px
		);
		clip-path: polygon(
			0 0, 100% 0, 98% 17%, 100% 33%, 98% 50%, 100% 67%, 98% 83%, 100% 100%,
			0 100%, 2% 83%, 0 67%, 2% 50%, 0 33%, 2% 17%
		);
		rotate: calc(var(--st-tilt) * 0.5 * var(--wobble));
	}

	/*
	  ホバーで角がめくれる（desk-3d）。幅 761px 以上・細かく指せる入力・動きを減らさない設定のときだけ。
	  角度には --wobble を掛けるので、整頓モードでは動かない。
	*/
	@media (min-width: 761px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.sticker-block .st-shape-host,
		.sticker-block .st-text {
			transition: rotate var(--spring), transform var(--spring);
			transform-origin: 0 100%;
		}

		.sticker-block .st-shape-host:hover,
		.sticker-block .st-text:hover {
			transform: perspective(600px) rotate3d(1, 1, 0, calc(16deg * var(--wobble)));
		}
	}
</style>
