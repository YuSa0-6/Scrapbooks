---
/**
 * 絵のカード。裏返せる（表＝写真とタイトル、裏＝写真の裏のメモ）。
 * - frame が polaroid（または空）：テープで貼ったポラロイド写真
 * - それ以外：M3E の形に切り抜いたダイカットシール（形は変形させない）
 * カード全体を 1 つのリンクにする：タイトルの <a> を ::after で広げる。
 * 裏返すボタンはリンクの外に置く（FlipCard）。
 */
import type { EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import FlipCard from "./FlipCard.astro";
import { isShapeName } from "../lib/shapes";
import { stickerColor, tapeColor, tiltFor, transitionName } from "../lib/pieces";

interface Props {
	dbId: string;
	title: string;
	summary?: string;
	featuredImage: MediaValue;
	href: string;
	client?: string;
	year?: string;
	note?: string;
	sticker?: string;
	frame?: string;
	tilt?: number;
	tags?: string[];
	edit?: EditProxy;
	headingLevel?: "h2" | "h3";
}

const {
	dbId,
	title,
	summary,
	featuredImage,
	href,
	client,
	year,
	note,
	sticker,
	frame,
	tilt,
	tags,
	edit,
	headingLevel: Heading = "h2",
} = Astro.props;
const allTags = tags || [];
const shaped = frame && frame !== "polaroid" && isShapeName(frame) ? frame : null;

const cardStyle = [
	`--tilt: ${tiltFor(dbId, tilt)}deg`,
	`--tape-color: ${tapeColor(dbId)}`,
	`--tape-rot: ${(dbId.length % 2 === 0 ? -5 : 4)}deg`,
	`--sticker-bg: ${stickerColor(dbId)}`,
	shaped ? `--shape-from: var(--shape-${shaped})` : "",
].join("; ");
---


<article class:list={["art-card", shaped ? "art-card--shaped" : "art-card--polaroid tape"]} style={cardStyle}>
	<FlipCard label={title}>
		<div slot="front" class:list={["flip-sheet", "art-front", { "flip-sheet--bare": shaped }]}>
			<div class="card-photo" style={`view-transition-name: ${transitionName("art", dbId)}`} {...edit?.featured_image}>
				{
					shaped ? (
						<div class="die">
							<span class="die-shadow" aria-hidden="true" />
							<span class="die-edge" aria-hidden="true" />
							<div class="photo-shape">
								<Image image={featuredImage} />
							</div>
						</div>
					) : (
						<Image image={featuredImage} />
					)
				}
			</div>
			<div class="card-body">
				<Heading class="card-title" {...edit?.title}>
					<a href={href} class="card-link">{title}</a>
				</Heading>
				{
					client && (
						<p class="card-meta" {...edit?.client}>
							{client}
						</p>
					)
				}
			</div>
		</div>
		<div slot="back" class="flip-sheet art-back">
			<p class="back-title hand" aria-hidden="true">— うら —</p>
			{
				note && (
					<p class="card-note hand" {...edit?.note}>
						{note}
					</p>
				)
			}
			{
				summary && (
					<p class="card-summary" {...edit?.summary}>
						{summary}
					</p>
				)
			}
			{
				year && (
					<p class="card-meta" {...edit?.year}>
						{year}
					</p>
				)
			}
			{
				allTags.length > 0 && (
					<ul class="card-tags" aria-label="タグ">
						{allTags.map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)
			}
			<a href={href} class="btn-label back-more" aria-label={`${title}を詳しく見る`}>
				詳しく見る
			</a>
		</div>
	</FlipCard>
	{
		sticker && (
			<span class="sticker card-sticker" aria-hidden="true" {...edit?.sticker}>
				{sticker}
			</span>
		)
	}
</article>

<style>
	.art-card {
		position: relative;
		rotate: calc(var(--tilt) * var(--wobble));
		transition:
			rotate var(--spring),
			translate var(--spring),
			scale var(--spring);
	}

	.art-card:hover,
	.art-card:focus-within {
		rotate: 0deg;
		translate: 0 -6px;
		scale: 1.03;
		z-index: 5;
	}

	/* カード全体のリンク：タイトルの <a> を ::after で面いっぱいに広げる */
	.card-link {
		color: var(--c-ink);
		text-decoration: none;
	}

	.card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.card-link:focus-visible {
		outline: none;
	}

	.card-link:focus-visible::after {
		outline: 3px dashed var(--color-brand);
		outline-offset: 6px;
	}

	/* ポラロイド */
	.art-card--polaroid .art-front {
		padding: 12px 12px 0;
		color: var(--c-ink);
	}

	.art-card--polaroid .card-photo {
		overflow: hidden;
		background: #ddd;
	}

	.card-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	/*
	  ダイカットシール：形に切り抜いて、白いふちと影をつける。
	  filter: drop-shadow は使わず、同じ形の層を重ねる：
	  影（ずらした半透明）→ 白いふち（少し大きい）→ 写真。写真の形は変形させない。
	*/
	.art-card--shaped .art-front {
		color: var(--c-ink);
	}

	.art-card--shaped .card-photo {
		padding: 12px;
	}

	.die {
		position: relative;
	}

	.die-shadow,
	.die-edge {
		position: absolute;
		inset: 0;
		clip-path: var(--shape-from);
		scale: 1.08;
	}

	.die-shadow {
		background: rgb(0 0 0 / 0.22);
		translate: 3px 6px;
	}

	.die-edge {
		background: #fff;
	}

	.photo-shape {
		position: relative;
		clip-path: var(--shape-from);
	}

	.photo-shape :global(img) {
		aspect-ratio: 1;
	}

	.art-card--shaped .card-body {
		margin-top: 10px;
		padding: var(--spacing-md) var(--spacing-md) var(--flip-btn-space);
		background: #fffdf7;
		box-shadow: var(--shadow-paper);
		/* rotate は付けない：変形した要素の中では、リンクの ::after が面いっぱいに広がらないため */
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		padding: var(--spacing-md) var(--spacing-xs) var(--flip-btn-space);
	}

	.card-title {
		font-size: var(--font-size-xl);
		line-height: 1.3;
		transition: color var(--fade-fast);
	}

	.art-card:hover .card-title {
		color: #c2185b;
	}

	.card-meta {
		font-size: var(--font-size-sm);
		color: #5b5147;
		font-weight: 700;
	}

	.card-summary {
		font-size: var(--font-size-sm);
		line-height: 1.7;
		color: #3a332c;
	}

	.card-note {
		font-size: var(--font-size-lg);
		color: #c2185b;
		rotate: calc(-1.5deg * var(--wobble));
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs) var(--spacing-sm);
		list-style: none;
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: #1f6f80;
	}

	/* 写真の裏：罫線の入った紙にメモを書いた感じ */
	.art-card .art-back {
		gap: var(--spacing-sm);
		padding: var(--spacing-lg) var(--spacing-md) var(--flip-btn-space);
		color: var(--c-ink);
		background-image: repeating-linear-gradient(
			transparent 0 27px,
			rgb(62 198 224 / 0.28) 27px 28px
		);
	}

	.back-title {
		font-size: var(--font-size-sm);
		color: #5b5147;
	}

	.back-more {
		align-self: flex-start;
		margin-top: auto;
		--btn-bg: var(--c-green);
	}

	.card-sticker {
		position: absolute;
		top: -14px;
		right: -14px;
		z-index: 3;
		pointer-events: none;
	}

	.art-card:hover .card-sticker {
		rotate: calc(-20deg * var(--wobble));
		scale: 1.15;
	}
</style>
