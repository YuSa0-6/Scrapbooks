---
/**
 * 絵のカード。
 * - frame が polaroid（または空）：テープで貼ったポラロイド写真
 * - それ以外：M3E の形に切り抜いたダイカットシール。ホバーで別の形にモーフする
 * カード全体を 1 つのリンクにして、押せる範囲を広く取る。
 */
import type { EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import { isShapeName } from "../lib/shapes";
import { stickerColor, tapeColor, tiltFor, transitionName } from "../lib/pieces";

interface Props {
	dbId: string;
	title: string;
	summary?: string;
	featuredImage: MediaValue;
	href: string;
	client?: string;
	year?: string;
	note?: string;
	sticker?: string;
	frame?: string;
	tilt?: number;
	tags?: string[];
	edit?: EditProxy;
	headingLevel?: "h2" | "h3";
}

const {
	dbId,
	title,
	summary,
	featuredImage,
	href,
	client,
	year,
	note,
	sticker,
	frame,
	tilt,
	tags,
	edit,
	headingLevel: Heading = "h2",
} = Astro.props;
const allTags = tags || [];
const shaped = frame && frame !== "polaroid" && isShapeName(frame) ? frame : null;

// 形ごとに、ホバーしたときの行き先の形
const morphTo: Record<string, string> = {
	cookie: "flower",
	flower: "sunny",
	sunny: "cookie",
	clover: "squircle",
	circle: "cookie",
};

const cardStyle = [
	`--tilt: ${tiltFor(dbId, tilt)}deg`,
	`--tape-color: ${tapeColor(dbId)}`,
	`--tape-rot: ${(dbId.length % 2 === 0 ? -5 : 4)}deg`,
	`--sticker-bg: ${stickerColor(dbId)}`,
	shaped ? `--shape-from: var(--shape-${shaped}); --shape-to: var(--shape-${morphTo[shaped] ?? "sunny"})` : "",
].join("; ");
---

<article class:list={["art-card", shaped ? "art-card--shaped" : "art-card--polaroid tape"]} style={cardStyle}>
	<a href={href} class="card-link morph-host">
		<div class="card-photo" style={`view-transition-name: ${transitionName("art", dbId)}`} {...edit?.featured_image}>
			{shaped ? <div class="morph photo-shape"><Image image={featuredImage} /></div> : <Image image={featuredImage} />}
		</div>
		<div class="card-body">
			<Heading class="card-title" {...edit?.title}>{title}</Heading>
			{
				(client || year) && (
					<p class="card-meta">
						{client && <span {...edit?.client}>{client}</span>}
						{client && year && <span aria-hidden="true"> / </span>}
						{year && <span {...edit?.year}>{year}</span>}
					</p>
				)
			}
			{
				summary && (
					<p class="card-summary" {...edit?.summary}>
						{summary}
					</p>
				)
			}
			{
				note && (
					<p class="card-note hand" {...edit?.note}>
						{note}
					</p>
				)
			}
			{
				allTags.length > 0 && (
					<ul class="card-tags" aria-label="タグ">
						{allTags.map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)
			}
		</div>
	</a>
	{
		sticker && (
			<span class="sticker card-sticker" aria-hidden="true" {...edit?.sticker}>
				{sticker}
			</span>
		)
	}
</article>

<style>
	.art-card {
		position: relative;
		rotate: calc(var(--tilt) * var(--wobble));
		transition:
			rotate var(--spring),
			translate var(--spring),
			scale var(--spring);
	}

	.art-card:hover,
	.art-card:focus-within {
		rotate: 0deg;
		translate: 0 -6px;
		scale: 1.03;
		z-index: 5;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: var(--c-ink);
		text-decoration: none;
	}

	.card-link:focus-visible {
		outline-offset: 6px;
	}

	/* ポラロイド */
	.art-card--polaroid .card-link {
		padding: 12px 12px 0;
		background: #fffdf7;
		box-shadow: var(--shadow-paper);
		transition: box-shadow var(--spring);
	}

	.art-card--polaroid:hover .card-link,
	.art-card--polaroid:focus-within .card-link {
		box-shadow: var(--shadow-lift);
	}

	.art-card--polaroid .card-photo {
		overflow: hidden;
		background: #ddd;
	}

	.card-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	/* ダイカットシール：形に切り抜いて、白いふちと影をつける */
	.art-card--shaped .card-photo {
		padding: 6px;
		filter: drop-shadow(4px 0 0 #fff) drop-shadow(-4px 0 0 #fff) drop-shadow(0 4px 0 #fff)
			drop-shadow(0 -4px 0 #fff) drop-shadow(3px 6px 0 rgb(0 0 0 / 0.22));
	}

	.photo-shape {
		--morph-rot: 6deg;
		--morph-scale: 1.02;
	}

	.photo-shape :global(img) {
		aspect-ratio: 1;
	}

	.art-card--shaped .card-body {
		margin-top: 10px;
		padding: var(--spacing-md);
		background: #fffdf7;
		box-shadow: var(--shadow-paper);
		rotate: calc(var(--tilt) * -0.6 * var(--wobble));
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		padding: var(--spacing-md) var(--spacing-xs) var(--spacing-lg);
	}

	.card-title {
		font-size: var(--font-size-xl);
		line-height: 1.3;
		transition: color var(--fade-fast);
	}

	.art-card:hover .card-title {
		color: #c2185b;
	}

	.card-meta {
		font-size: var(--font-size-sm);
		color: #5b5147;
		font-weight: 700;
	}

	.card-summary {
		font-size: var(--font-size-sm);
		line-height: 1.7;
		color: #3a332c;
	}

	.card-note {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-lg);
		color: #c2185b;
		rotate: calc(-1.5deg * var(--wobble));
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs) var(--spacing-sm);
		margin-top: var(--spacing-sm);
		list-style: none;
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: #1f6f80;
	}

	.card-sticker {
		position: absolute;
		top: -14px;
		right: -14px;
		z-index: 3;
		pointer-events: none;
	}

	.art-card:hover .card-sticker {
		rotate: calc(-20deg * var(--wobble));
		scale: 1.15;
	}
</style>
