---
/**
 * M3E の FAB メニュー。右下の手描きの枠のボタンを押すと、操作の一覧がばねで広がる。
 * 枠はいびつな border-radius、色はクレヨン。押すと形が変わる（border-radius のばね）。
 * ボード（Board.astro）にイベントを送るだけで、自分では配置を持たない。
 * 管理者（isAdmin）のときだけ、「この並べ方を公開する」の項目と結果の表示（role="status"）を足す。
 */
interface Props {
	/** Base.astro と同じ判定：Astro.locals.user があるか */
	isAdmin?: boolean;
}

const { isAdmin = false } = Astro.props;
---

<div class="fab-menu" data-fab>
	<ul class="fab-items" id="fab-items" data-fab-items>
		{
			isAdmin && (
				<li style="--n: 3; --item-bg: var(--crayon-lilac)">
					<button type="button" class="fab-item" data-action="publish" data-free-only>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 16V4M7 9l5-5 5 5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
						</svg>
						この並べ方を公開する
					</button>
				</li>
			)
		}
		<li style="--n: 2; --item-bg: var(--crayon-yellow)">
			<button type="button" class="fab-item" data-action="shuffle" data-free-only>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h3.5c2 0 3.2 1 4.3 2.7l2.4 4.6C14.3 16 15.5 17 17.5 17H21M17.5 14 21 17l-3.5 3M3 17h3.5c1.3 0 2.2-.4 3-1.2M13.5 8.2c.8-.8 1.7-1.2 3-1.2H21M17.5 4 21 7l-3.5 3"></path></svg>
				シャッフル
			</button>
		</li>
		<li style="--n: 1; --item-bg: var(--crayon-sage)">
			<button type="button" class="fab-item" data-action="reset" data-free-only>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v5h5"></path></svg>
				もとの配置
			</button>
		</li>
		<li style="--n: 0; --item-bg: var(--crayon-blue)">
			<button type="button" class="fab-item" data-action="random">
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"></rect><circle cx="9" cy="9" r="1.3"></circle><circle cx="15" cy="15" r="1.3"></circle><circle cx="15" cy="9" r="1.3"></circle><circle cx="9" cy="15" r="1.3"></circle></svg>
				どれか 1 つ見る
			</button>
		</li>
	</ul>
	{isAdmin && <p class="fab-status" role="status" data-fab-status />}
	<button
		type="button"
		class="fab"
		aria-expanded="false"
		aria-controls="fab-items"
		aria-label="ボードの操作"
		data-fab-toggle
	>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
	</button>
</div>

<script>
	const fab = document.querySelector<HTMLElement>("[data-fab]");
	const toggle = fab?.querySelector<HTMLButtonElement>("[data-fab-toggle]");

	function setOpen(open: boolean) {
		fab?.classList.toggle("is-open", open);
		toggle?.setAttribute("aria-expanded", String(open));
	}

	toggle?.addEventListener("click", (event) => {
		const open = !fab?.classList.contains("is-open");
		setOpen(open);
		// キーボードで開いたら、最初の項目へフォーカスを移す（項目はボタンより前にあるため、Tab では入れない）
		if (open && event.detail === 0) {
			const first = Array.from(fab?.querySelectorAll<HTMLElement>(".fab-item") ?? []).find(
				(item) => !item.closest("li")?.hidden,
			);
			first?.focus();
		}
	});

	// 並べ方の公開：押されたときに初めて読み込む（見る人の JS には入らない）
	const status = fab?.querySelector<HTMLElement>("[data-fab-status]") ?? null;
	let publishing = false;
	async function publish(button: HTMLButtonElement) {
		if (publishing) return;
		publishing = true;
		button.setAttribute("aria-disabled", "true");
		try {
			const { publishBoardLayout } = await import("../scripts/board/publish");
			await publishBoardLayout(status);
		} catch {
			if (status) status.textContent = "公開の準備ができませんでした。ページを開きなおしてください";
		} finally {
			publishing = false;
			button.removeAttribute("aria-disabled");
		}
	}

	fab?.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((button) => {
		button.addEventListener("click", () => {
			if (button.dataset.action === "publish") {
				void publish(button);
			} else {
				document.dispatchEvent(new CustomEvent(`board:${button.dataset.action}`));
			}
			setOpen(false);
			toggle?.focus();
		});
	});

	// Esc キーと、メニューの外をクリックしたときに閉じる
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && fab?.classList.contains("is-open")) {
			setOpen(false);
			toggle?.focus();
		}
	});
	document.addEventListener("click", (event) => {
		if (fab && !fab.contains(event.target as Node)) setOpen(false);
	});

	// 自由配置でないとき（スマホ・整頓モード）は、並べ替えの操作を隠す
	function applyMode(free: boolean) {
		fab?.querySelectorAll<HTMLElement>("[data-free-only]").forEach((button) => {
			button.closest("li")!.hidden = !free;
		});
	}

	document.addEventListener("board:mode", (event) => {
		applyMode((event as CustomEvent<{ free: boolean }>).detail.free);
	});
	// ボードのほうが先に並べ終わっていた場合に備えて、今の状態も見る
	applyMode(Boolean(document.querySelector("[data-board].is-free")));
</script>

<style>
	.fab-menu {
		position: fixed;
		right: max(var(--spacing-lg), env(safe-area-inset-right));
		bottom: max(var(--spacing-lg), env(safe-area-inset-bottom));
		z-index: 60;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--spacing-sm);
	}

	svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/*
	  閉じているときは、いびつな角の四角（M3E の FAB を手で描いたもの）。クレヨンのピンク。
	  ホバーで別のいびつさに変わり、開くと丸になる。動かすのは border-radius / rotate / scale だけ。
	*/
	.fab {
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		color: var(--crayon-ink);
		background: var(--crayon-pink);
		border: 2px solid var(--color-text);
		border-radius: 26px 10px 22px 12px / 12px 22px 10px 26px;
		box-shadow: var(--shadow-crayon);
		cursor: pointer;
		transition:
			border-radius var(--spring),
			rotate var(--spring),
			scale var(--spring-fast),
			background var(--fade-fast);
	}

	.fab svg {
		width: 28px;
		height: 28px;
		stroke-width: 2.6;
		transition: rotate var(--spring);
	}

	.fab:hover {
		border-radius: 10px 26px 12px 22px / 22px 12px 26px 10px;
	}

	.fab:active {
		scale: 0.92;
	}

	/* 開いたら手描きの丸になり、+ が × に回る */
	.is-open .fab {
		border-radius: var(--hand-round);
		background: var(--crayon-yellow);
	}

	.is-open .fab svg {
		rotate: 135deg;
	}

	.fab-items {
		list-style: none;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--spacing-sm);
		pointer-events: none;
	}

	.fab-items li {
		opacity: 0;
		translate: 0 16px;
		scale: 0.6;
		transform-origin: right center;
		transition:
			opacity var(--fade-fast),
			translate var(--spring),
			scale var(--spring);
		transition-delay: calc(var(--n) * 30ms);
	}

	.is-open .fab-items {
		pointer-events: auto;
	}

	.is-open .fab-items li {
		opacity: 1;
		translate: 0 0;
		scale: 1;
	}

	.fab-items li[hidden] {
		display: none;
	}

	/* 閉じているメニューには Tab で入れないようにする */
	.fab-menu:not(.is-open) .fab-item {
		visibility: hidden;
		transition: visibility 0s var(--m3e-default-spatial-duration);
	}

	/* 項目：クレヨンで塗った手描きの枠。1 つおきに枠のいびつさを変える。押すと形が変わる */
	.fab-item {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-sm);
		min-height: 52px;
		padding: 0 var(--spacing-lg) 0 var(--spacing-md);
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		font-weight: 700;
		color: var(--crayon-ink);
		background: var(--item-bg, var(--crayon-yellow));
		border: 2px solid var(--color-text);
		border-radius: var(--hand-radius);
		box-shadow: var(--shadow-crayon);
		cursor: pointer;
		transition:
			border-radius var(--spring-fast),
			scale var(--spring-fast);
	}

	.fab-items li:nth-child(even) .fab-item {
		border-radius: var(--hand-radius-alt);
	}

	.fab-item:hover {
		scale: 1.04;
		border-radius: var(--hand-radius-alt);
	}

	.fab-items li:nth-child(even) .fab-item:hover {
		border-radius: var(--hand-radius);
	}

	.fab-item:active {
		scale: 0.95;
		border-radius: var(--hand-round);
	}

	.fab-item[aria-disabled="true"] {
		opacity: 0.6;
		cursor: progress;
	}

	/* 結果の表示：FAB の左に出す黄色のふせん。動かすのは opacity だけ */
	.fab-status {
		position: absolute;
		right: calc(64px + var(--spacing-md));
		bottom: var(--spacing-sm);
		width: max-content;
		max-width: min(320px, calc(100vw - 64px - var(--spacing-lg) * 3));
		padding: var(--spacing-sm) var(--spacing-md);
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		font-weight: 700;
		color: var(--crayon-ink);
		background: var(--crayon-yellow);
		border: 2px solid var(--color-text);
		border-radius: var(--hand-radius-soft);
		box-shadow: var(--shadow-crayon);
		opacity: 1;
		transition: opacity var(--fade-fast);
		pointer-events: none;
	}

	.fab-status:empty {
		opacity: 0;
	}
</style>
