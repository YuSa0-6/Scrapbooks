---
/**
 * 脅迫状風（切り抜き文字）のタイトル。
 * 1 文字ずつ色・書体・傾きを変える。並びは文字の位置で決まるので、
 * 表示のたびに変わらない（サーバー描画とずれない）。
 * 読み上げでは 1 つのまとまった文字列として扱う。
 */
interface Props {
	text: string;
	as?: "h1" | "h2" | "p";
	size?: "lg" | "xl";
}

const { text, as: Tag = "h1", size = "xl" } = Astro.props;
const chars = Array.from(text);
const styles = ["a", "b", "c", "d", "e", "f"];
const tilts = [-6, 4, -2, 7, -4, 3, -7, 2];
---

<Tag class:list={["ransom", `ransom--${size}`]} aria-label={text}>
	{
		chars.map((ch, i) =>
			ch.trim() === "" ? (
				<span class="gap" aria-hidden="true" />
			) : (
				<span
					class={`piece piece--${styles[(i * 7 + ch.codePointAt(0)!) % styles.length]}`}
					style={`--t: ${tilts[i % tilts.length]}deg; --d: ${i * 40}ms`}
					aria-hidden="true"
				>
					{ch}
				</span>
			),
		)
	}
</Tag>

<style>
	.ransom {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.08em;
		line-height: 1;
	}

	.ransom--xl {
		font-size: clamp(1.9rem, 8.5vw, 5rem);
	}

	.ransom--lg {
		font-size: clamp(2rem, 5vw, 3.25rem);
	}

	.gap {
		width: 0.35em;
	}

	.piece {
		display: inline-block;
		padding: 0.08em 0.12em 0.12em;
		rotate: calc(var(--t) * var(--wobble));
		box-shadow: 2px 3px 0 rgb(0 0 0 / 0.2);
		animation: drop 500ms cubic-bezier(0.2, 1.6, 0.4, 1) both;
		animation-delay: var(--d);
		transition: rotate var(--transition-base), translate var(--transition-base);
	}

	.piece:hover {
		rotate: calc(var(--t) * -1 * var(--wobble));
		translate: 0 -4px;
	}

	.piece--a {
		font-family: var(--font-heading);
		background: var(--c-yellow);
		color: var(--c-ink);
	}

	.piece--b {
		font-family: var(--font-heading);
		background: var(--c-ink);
		color: #fff;
	}

	.piece--c {
		font-family: var(--font-hand);
		font-weight: 700;
		background: #fff;
		color: var(--c-ink);
		outline: 2px solid var(--c-ink);
	}

	.piece--d {
		font-family: var(--font-heading);
		background: var(--c-pink);
		color: #fff;
		border-radius: 50%;
		padding-inline: 0.2em;
	}

	.piece--e {
		font-family: var(--font-body);
		font-weight: 700;
		background: var(--c-cyan);
		color: var(--c-ink);
	}

	.piece--f {
		font-family: var(--font-heading);
		background: var(--c-green);
		color: var(--c-ink);
		text-decoration: underline wavy var(--c-ink) 2px;
		text-underline-offset: 0.12em;
	}

	@keyframes drop {
		from {
			opacity: 0;
			translate: 0 -40px;
			rotate: calc(var(--t) * 4);
		}
	}

	:global(.tidy) .piece {
		animation: none;
	}
</style>
