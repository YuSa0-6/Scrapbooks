---
/**
 * 手書きの大見出し。Klee One 600 で書き、下に蛍光ペンの線を引く。
 * 線は飾りなので読み上げには出ない（aria-hidden の SVG）。文字はそのまま 1 つの見出しとして読まれる。
 * 線が「引かれる」動きは scale だけ。整頓モードと prefers-reduced-motion では止まる。
 */
interface Props {
	text: string;
	as?: "h1" | "h2" | "p";
	size?: "lg" | "xl";
}

const { text, as: Tag = "h1", size = "xl" } = Astro.props;
---

<Tag class:list={["hand-title", `hand-title--${size}`]}>
	<span class="hand-title-text">{text}</span>
	<svg
		class="hand-title-line"
		viewBox="0 0 420 28"
		preserveAspectRatio="none"
		fill="none"
		stroke="currentColor"
		stroke-width="7"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<path vector-effect="non-scaling-stroke" d="M6 16c60-10 120 8 190-2 70-9 140 6 218-4"></path>
	</svg>
</Tag>

<style>
	.hand-title {
		position: relative;
		display: inline-block;
		max-width: 100%;
		padding-bottom: 0.12em;
		font-family: var(--font-heading);
		font-weight: var(--font-weight-display);
		line-height: 1.1;
		color: var(--color-text);
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.hand-title--xl {
		font-size: clamp(2.75rem, 11vw, 5.75rem);
	}

	.hand-title--lg {
		font-size: clamp(2.25rem, 8vw, 3.75rem);
	}

	.hand-title-line {
		position: absolute;
		left: -2%;
		bottom: -0.12em;
		width: 104%;
		height: 0.28em;
		color: var(--hl-line);
		opacity: 0.75;
		pointer-events: none;
		transform-origin: left center;
		animation: draw-line 700ms var(--m3e-default-spatial) 150ms both;
	}

	@keyframes draw-line {
		from {
			scale: 0 1;
		}
	}

	:global(.tidy) .hand-title-line {
		animation: none;
	}
</style>
