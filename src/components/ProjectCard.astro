---
/**
 * 作品カード。ポラロイド写真をテープで貼ったような見た目。
 * 傾きは index で決め、ホバー・フォーカスでまっすぐに戻す。
 * カード全体を 1 つのリンクにして、押せる範囲を広く取る。
 */
import type { EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	summary?: string;
	featuredImage: MediaValue;
	href: string;
	client?: string;
	year?: string;
	note?: string;
	sticker?: string;
	tags?: string[];
	edit?: EditProxy;
	index?: number;
	headingLevel?: "h2" | "h3";
}

const {
	title,
	summary,
	featuredImage,
	href,
	client,
	year,
	note,
	sticker,
	tags,
	edit,
	index = 0,
	headingLevel: Heading = "h2",
} = Astro.props;
const allTags = tags || [];

const tilts = [-3, 2.5, -1.5, 3.5, -2.5, 1.5];
const tapes = ["var(--c-yellow)", "var(--c-pink)", "var(--c-cyan)", "var(--c-green)"];
const stickerColors = ["var(--c-pink)", "var(--c-yellow)", "var(--c-green)", "var(--c-purple)"];
const cardStyle = [
	`--tilt: ${tilts[index % tilts.length]}deg`,
	`--tape-color: ${tapes[index % tapes.length]}`,
	`--tape-rot: ${index % 2 === 0 ? -5 : 4}deg`,
	`--sticker-bg: ${stickerColors[index % stickerColors.length]}`,
].join("; ");
---

<article class="project-card tape" style={cardStyle}>
	<a href={href} class="card-link">
		<div class="card-photo" {...edit?.featured_image}>
			<Image image={featuredImage} />
		</div>
		<div class="card-body">
			<Heading class="card-title" {...edit?.title}>{title}</Heading>
			{
				(client || year) && (
					<p class="card-meta">
						{client && <span {...edit?.client}>{client}</span>}
						{client && year && <span aria-hidden="true"> / </span>}
						{year && <span {...edit?.year}>{year}</span>}
					</p>
				)
			}
			{
				summary && (
					<p class="card-summary" {...edit?.summary}>
						{summary}
					</p>
				)
			}
			{
				note && (
					<p class="card-note hand" {...edit?.note}>
						{note}
					</p>
				)
			}
			{
				allTags.length > 0 && (
					<ul class="card-tags" aria-label="タグ">
						{allTags.map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)
			}
		</div>
	</a>
	{
		sticker && (
			<span class="sticker card-sticker" aria-hidden="true" {...edit?.sticker}>
				{sticker}
			</span>
		)
	}
</article>

<style>
	.project-card {
		position: relative;
		rotate: calc(var(--tilt) * var(--wobble));
		transition:
			rotate var(--transition-slow),
			translate var(--transition-slow),
			scale var(--transition-slow);
	}

	.project-card:hover,
	.project-card:focus-within {
		rotate: 0deg;
		translate: 0 -6px;
		scale: 1.02;
		z-index: 5;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 12px 12px 0;
		background: #fffdf7;
		color: var(--c-ink);
		text-decoration: none;
		box-shadow: var(--shadow-paper);
		transition: box-shadow var(--transition-slow);
	}

	.project-card:hover .card-link,
	.project-card:focus-within .card-link {
		box-shadow: var(--shadow-lift);
	}

	.card-link:focus-visible {
		outline-offset: 6px;
	}

	.card-photo {
		overflow: hidden;
		background: #ddd;
	}

	.card-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		filter: saturate(1.05) contrast(1.02);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
		padding: var(--spacing-md) var(--spacing-xs) var(--spacing-lg);
	}

	.card-title {
		font-size: var(--font-size-xl);
		line-height: 1.3;
	}

	.project-card:hover .card-title {
		color: #c2185b;
	}

	.card-meta {
		font-size: var(--font-size-sm);
		color: #5b5147;
		font-weight: 700;
	}

	.card-summary {
		font-size: var(--font-size-sm);
		line-height: 1.7;
		color: #3a332c;
	}

	.card-note {
		margin-top: var(--spacing-xs);
		font-size: var(--font-size-lg);
		color: #c2185b;
		rotate: calc(-1.5deg * var(--wobble));
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs) var(--spacing-sm);
		margin-top: var(--spacing-sm);
		list-style: none;
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: #1f6f80;
	}

	.card-sticker {
		position: absolute;
		top: -14px;
		right: -14px;
		z-index: 3;
		pointer-events: none;
	}
</style>
